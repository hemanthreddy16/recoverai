# =====================================================================
# RESURGE Environment Configuration Template
# Copy this file to .env and customize values for your environment.
# DO NOT commit .env with production credentials to source control.
# =====================================================================

# --- Project & Environment ---
PROJECT_NAME=RESURGE
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# --- Database Configuration (PostgreSQL / SQLite) ---
# For Docker Compose: postgresql://resurge:resurge_password@postgres:5432/resurge_db
# For Local Dev without Docker: sqlite:///./resurge.db
DATABASE_URL=postgresql://resurge:resurge_password@postgres:5432/resurge_db
POSTGRES_USER=resurge
POSTGRES_PASSWORD=resurge_password
POSTGRES_DB=resurge_db
POSTGRES_PORT=5432

# --- Security & JWT Authentication ---
# Generate a secure 64+ char random string for production
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Model Context Protocol (MCP) Server ---
MCP_AUTH_TOKEN=resurge-mcp-auth-token-replace-in-prod
MCP_EXTERNAL=false
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m app.mcp.server

# --- LLM Integration (Optional) ---
# Options: none | openai | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# --- Razorpay Payment Gateway (Test Mode) ---
# Set RAZORPAY_ENABLED=true only when you have real Razorpay test keys.
# When false, the system uses a safe local simulation mode with
# POST /api/v1/webhooks/simulate for demo purposes — no external keys needed.
RAZORPAY_KEY_ID=rzp_test_TUq0xOIYlSUREb
RAZORPAY_KEY_SECRET=ZHQFiQSyxdtg7rFo0XgdaOxg
# Webhook secret for HMAC-SHA256 signature validation.
# Generate one at Razorpay Dashboard > Settings > Webhooks.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENABLED=true
# Merchant tenant ID that maps incoming Razorpay webhooks.
WEBHOOK_MERCHANT_ID=1

# --- CORS & Networking ---
# Comma-separated origins or * for open development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=120

# --- Frontend Settings ---
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
